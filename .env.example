# Copiá este archivo a .env y completá los valores

# App
PORT=3001
NODE_ENV=development

# Base de datos (`docker compose up -d db` levanta una local con estos datos)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambiar
DB_NAME=KatanaFinance
# Crea/modifica las tablas solo según las entidades. SOLO en desarrollo:
# en producción dejarlo en false y usar migraciones.
DB_SYNC=true

# JWT: mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth (opcional: si está vacío, el login con Google responde 503)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Frontend URL (para CORS y el redirect después del login con Google)
FRONTEND_URL=http://localhost:3000

# API key del bot (n8n la manda en el header x-api-key). Mínimo 24 caracteres.
BOT_API_KEY=
